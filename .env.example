# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB:  mongodb://127.0.0.1:27017/learnhub
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/learnhub
MONGO_URI=mongodb://127.0.0.1:27017/learnhub

# ---- Auth ----
# Generate a long random string, e.g: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Seed admin account (created automatically on first server start) ----
ADMIN_NAME=Fawuzan Ismael
ADMIN_EMAIL=fawuzanismael@gmail.com
ADMIN_PASSWORD=123123@

# ---- CORS (only needed if frontend is hosted on a different domain) ----
CLIENT_ORIGIN=
